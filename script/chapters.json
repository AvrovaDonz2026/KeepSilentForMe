          "face": "紧张",
          "zones": [
            {"text": "很容易把事情搞砸", "remain": "我叫——算了，名字不重要，我只是一个很普通的人。", "npc": "普通也没关系。", "flags": ["pass+"], "eat": "很容易把事情搞砸"},
            {"text": "名字不重要，", "remain": "我叫——算了，我只是一个很普通、很容易把事情搞砸的人。", "npc": "先告诉我怎么称呼？", "flags": ["fail+"], "eat": "名字不重要"},
